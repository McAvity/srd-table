{
  "name": "srd-table",
  "version": "0.1.0",
  "private": true,
  "description": "A browser app for 5th-edition play (SRD 5.2.1): character builder, character sheet and encounter tracker, over srd-rules-engine.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "content": "tsx scripts/copy-content.ts",
    "bundle:character": "tsx scripts/bundle-to-character.ts",
    "engine:update": "git -C ../srd-rules-engine-main checkout -q --detach main && (cd ../srd-rules-engine-main && npm ci --no-audit --no-fund && npx tsdown --config-loader tsx) && npm run content",
    "predev": "npm run content",
    "dev": "vite",
    "prebuild": "npm run content",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "pree2e": "npm run content",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run content && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-virtual": "^3.14.13",
    "comlink": "^4.4.2",
    "idb": "^8.0.3",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "srd-rules-engine": "file:../srd-rules-engine-main",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
